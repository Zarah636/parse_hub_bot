##### Bot 配置 #####
API_HASH=
API_ID=
BOT_TOKEN=
# 海外服务器无需填写
# BOT_PROXY=http://127.0.0.1:7890

##### FlyingLife 优先解析（可选） #####
# FLYINGLIFE_ENABLED=true
# 默认只接管已验证的抖音平台；多个平台 ID 使用英文逗号分隔
# FLYINGLIFE_PLATFORMS=douyin
# 推荐运行 `python tools/flyinglife_auth.py` 保存会话；也可直接通过环境变量提供
# FLYINGLIFE_SESSION_ID=
# FLYINGLIFE_BASE_URL=https://parse.flyinglife.cn
# FLYINGLIFE_CONCURRENCY=1
# 内联弹窗不宜长时间等待 FlyingLife，超时后立即回退 ParseHub
# FLYINGLIFE_INLINE_PARSE_TIMEOUT=5
# Bot 管理员 ID, 逗号分隔；/admin 和 /flyinglife 全局开关仅允许这些用户操作
# ADMIN_IDS=123456789,987654321
# 全部引擎共享的下载/转码/上传并发上限；R5S 可从 1 开始
# PARSE_CONCURRENCY=2
# 退出时等待任务完成的秒数；到期取消后再关闭客户端并清理下载文件
# PARSE_SHUTDOWN_TIMEOUT=30
