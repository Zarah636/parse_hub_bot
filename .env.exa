##### Bot 配置 #####
API_HASH=
API_ID=
BOT_TOKEN=
# 海外服务器无需填写
# BOT_PROXY=http://127.0.0.1:7890

##### FlyingLife 优先解析（可选） #####
# FLYINGLIFE_ENABLED=true
# 第一版默认只接管抖音，可用逗号添加已验证的平台 ID
# FLYINGLIFE_PLATFORMS=douyin
# 推荐运行 `python tools/flyinglife_auth.py` 保存会话；也可直接通过环境变量提供
# FLYINGLIFE_SESSION_ID=
# FLYINGLIFE_BASE_URL=https://parse.flyinglife.cn
# FLYINGLIFE_CONCURRENCY=1

##### Docker / R5S 挂载路径（可选） #####
# DOCKER_PLATFORM=linux/arm64
# BOT_DATA_DIR=./data
# BOT_DOWNLOADS_DIR=./downloads
# BOT_LOGS_DIR=./logs
